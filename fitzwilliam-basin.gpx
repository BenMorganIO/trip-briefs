<?xml version="1.0" encoding="UTF-8"?>
<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" creator="Littlebird Trip Briefs">
  <metadata>
    <name>Fitzwilliam Basin Approach with Bucephalus, Frontier, and Kataka</name>
    <desc>Reference track for Mount Robson Provincial Park. Approach trail is approximate; scramble routes are point-to-point only. Verify on the ground.</desc>
    <time>2026-09-03T20:00:00Z</time>
  </metadata>
  <wpt lat="52.8608" lon="-118.5347">
    <name>Trailhead</name>
    <desc>Yellowhead Lake boat launch parking. Across Hwy 16 from boat launch sign. Self-register at kiosk ~1.3 km along pipeline ROW.</desc>
    <ele>1110</ele>
  </wpt>
  <wpt lat="52.8416" lon="-118.4883">
    <name>Rockingham Creek Camp</name>
    <desc>7.2 km from trailhead. 6 tent pads, pit toilet, bear pole. Water from creek.</desc>
    <ele>1700</ele>
  </wpt>
  <wpt lat="52.8350" lon="-118.4500">
    <name>Alpine Wilderness Camp</name>
    <desc>~13.5 km from trailhead at north end of first alpine lake. 3 tent pads, bear pole, open pit toilet. No fires.</desc>
    <ele>2100</ele>
  </wpt>
  <wpt lat="52.83056" lon="-118.45694">
    <name>Mount Fitzwilliam</name>
    <desc>2902 m. Loose, rotten rock on upper mountain. Class 2-3 scrambling. Helmet strongly recommended.</desc>
    <ele>2902</ele>
  </wpt>
  <wpt lat="52.82226" lon="-118.44476">
    <name>Bucephalus Peak</name>
    <desc>2763 m. More stable rock than Fitzwilliam. ~45 min from Fitzwilliam/Bucephalus col.</desc>
    <ele>2763</ele>
  </wpt>
  <wpt lat="52.81582" lon="-118.43031">
    <name>Frontier Peak</name>
    <desc>2682 m. NW Ridge from Bucephalus/Frontier col is Class 2 scrambling over boulder field.</desc>
    <ele>2682</ele>
  </wpt>
  <wpt lat="52.831885" lon="-118.397097">
    <name>Kataka Mountain</name>
    <desc>2679 m. East side of Fitzwilliam Basin. Limited route beta; exploratory scramble from basin.</desc>
    <ele>2679</ele>
  </wpt>
